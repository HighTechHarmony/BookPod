# systemd service unit example for the bookpod audiobook RSS web app.
#
# HOW TO USE
#   1. (Recommended) Deploy the app to /opt/bookpod and create a service user:
#        sudo mkdir -p /opt/bookpod
#        sudo chown -R bookpod:bookpod /opt/bookpod
#        sudo useradd --system --shell /usr/sbin/nologin --home-dir /opt/bookpod bookpod
#      ...or, if you keep the app where it is (under /home), change
#      WorkingDirectory / ExecStart / ReadWritePaths and set ProtectHome=false.
#
#   2. Copy this file to /etc/systemd/system/bookpod.service and enable it:
#        sudo cp bookpod.service.example /etc/systemd/system/bookpod.service
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now bookpod
#
#   3. Inspect logs:
#        journalctl -u bookpod -f
#
# NOTE: feed_url.txt (the private default feed) is read from the app directory;
# it is git-ignored, so deploy it along with the code.

[Unit]
Description=bookpod audiobook RSS feed web app
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

# Run as a dedicated service user. If the app stays under /home, use your own
# user instead (e.g. User=scott) and see the ProtectHome note below.
User=bookpod
Group=bookpod

# Directory containing main.py, feed.py, templates/ and covers/
WorkingDirectory=/opt/bookpod

# Point ExecStart at the project venv's uvicorn. The app object is "app" in
# module "main". One worker is fine (each worker keeps its own in-memory feed
# cache); add --workers N only if you really want more.
ExecStart=/opt/bookpod/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

# Optional environment overrides (see main.py / feed.py). Uncomment to set:
#Environment=CACHE_DIR=/var/cache/bookpod
#Environment=PAGE_SIZE=24
#Environment=REFRESH=0

# Flush Python stdout/stderr so logs appear in journald immediately.
Environment=PYTHONUNBUFFERED=1

# Restart on crash, and let the server stop cleanly.
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# ---- Hardening -----------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
# Whole filesystem read-only except the paths listed in ReadWritePaths below.
ProtectSystem=strict
# Set to false if the app lives under /home (e.g. /home/<user>/dev/audiobook_feed_library).
ProtectHome=true
# Paths the service may write to: the app dir (for covers/) and the cover/feed cache.
ReadWritePaths=/opt/bookpod /var/cache/bookpod
# No core dumps.
LimitCORE=0

# NOTE: if you set CACHE_DIR above to something else, add it to ReadWritePaths.

[Install]
WantedBy=multi-user.target
